# Supabase keys for the GM area. Copy this file to .env and fill in your project's values
# (Supabase dashboard > Project Settings > API). The .env file is gitignored.
#
# The PUBLIC_ prefix makes Astro inline the value into the client bundle. That is fine:
# the anon key is public by design, and the real security is the row-level policies in
# supabase/migration.sql.
#
# Without these two values the site still builds and works; only the GM area shows a
# "not configured yet" notice.

PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
