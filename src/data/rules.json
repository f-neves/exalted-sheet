{
  "_doc": "Shared, splat-independent constants. Anything that differs per Exalt type lives in src/data/splats/*.json.",

  "defaultBudget": 0,
  "defaultSplat": "solar",

  "_maxRatingDoc": "How many dots each row draws. Raise a number here to allow higher ratings; a rating already above the cap still draws all of its dots.",
  "maxRating": {
    "attribute": 5,
    "ability": 5,
    "virtue": 5,
    "willpower": 10,
    "essence": 10,
    "background": 5,
    "specialty": 3
  },

  "healthTrack": [
    { "id": "l0",  "label": "-0",    "penalty": 0,  "count": 1 },
    { "id": "l1",  "label": "-1",    "penalty": -1, "count": 2 },
    { "id": "l2",  "label": "-2",    "penalty": -2, "count": 2 },
    { "id": "l4",  "label": "-4",    "penalty": -4, "count": 1 },
    { "id": "inc", "label": "Incap", "penalty": null, "count": 1 }
  ],

  "movement": {
    "_doc": "Yards per tick. move = dexterity*mult + base",
    "move": { "dexterity": 1, "base": 3 },
    "dash": { "dexterity": 1, "base": 6 }
  },

  "derived": {
    "_doc": "Canonical Exalted 2e. Every DV rounds UP. Mobility penalty from armour is applied to Dodge DV and Parry DV.",
    "dodgeDV":  { "terms": { "dexterity": 1, "dodge": 1, "essence": 1 }, "divisor": 2, "round": "up" },
    "parryDV":  { "terms": { "dexterity": 1, "ability": 1, "weaponDefense": 1 }, "divisor": 2, "round": "up" },
    "mdv":      { "terms": { "willpower": 1, "integrity": 1, "essence": 1 }, "divisor": 2, "round": "up" },
    "joinBattle": { "terms": { "wits": 1, "awareness": 1 } },
    "joinDebate": { "terms": { "wits": 1, "socialize": 1 } }
  },

  "weaponDefaults": {
    "speed": 5, "accuracy": 0, "damage": 0, "damageType": "L",
    "rate": 2, "defense": 0, "range": 0, "minimumStrength": 0
  },

  "armorDefaults": {
    "soakB": 0, "soakL": 0, "soakA": 0,
    "hardness": 0, "mobility": 0, "fatigue": 0
  },

  "damageTypes": [
    { "id": "B", "name": "Bashing" },
    { "id": "L", "name": "Lethal" },
    { "id": "A", "name": "Aggravated" }
  ],

  "attackAbilities": [
    { "id": "melee",        "name": "Melee",        "attr": "dexterity" },
    { "id": "martial-arts", "name": "Martial Arts", "attr": "dexterity" },
    { "id": "archery",      "name": "Archery",      "attr": "dexterity" },
    { "id": "thrown",       "name": "Thrown",       "attr": "dexterity" }
  ]
}
