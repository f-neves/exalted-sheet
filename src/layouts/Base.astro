---
import '../styles/global.css';

interface Props { title: string; description?: string }
const { title, description = 'Exalted 2nd Edition interactive character sheet.' } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="topbar">
      <a class="brand" href={base}>Exalted<small>Second Edition</small></a>
      <nav class="topnav">
        <a href={`${base}sheet`}>Sheet</a>
        <a href={`${base}characters`} id="nav-characters" hidden>Characters</a>
        <a href={`${base}campaigns`} id="nav-campaigns" hidden>Campaigns</a>
      </nav>
      <span class="spacer"></span>
      <a class="btn" id="auth-link" href={`${base}login`}><span class="auth-label">Sign in</span></a>
      <button class="btn" id="theme-toggle" type="button" title="Toggle light / dark">Parchment</button>
    </header>
    <main class="content" id="main">
      <slot />
    </main>

    <script is:inline>
      (function () {
        var KEY = 'exalted:theme';
        var root = document.documentElement;
        try {
          var saved = localStorage.getItem(KEY);
          if (saved) root.setAttribute('data-theme', saved);
        } catch (e) {}
        var btn = document.getElementById('theme-toggle');
        function label() {
          btn.textContent = root.getAttribute('data-theme') === 'parchment' ? 'Dark' : 'Parchment';
        }
        label();
        btn.addEventListener('click', function () {
          var next = root.getAttribute('data-theme') === 'parchment' ? 'dark' : 'parchment';
          root.setAttribute('data-theme', next);
          try { localStorage.setItem(KEY, next); } catch (e) {}
          label();
        });
      })();
    </script>

    <script>
      // Auth state in the topbar. The auth lib is imported dynamically so pages that
      // never touch Supabase do not pay for the bundle, and every failure is swallowed:
      // an outage must not be able to break the navigation.
      (async () => {
        const link = document.getElementById('auth-link');
        const label = link?.querySelector('.auth-label');
        const campaigns = document.getElementById('nav-campaigns');
        const characters = document.getElementById('nav-characters');
        if (!link || !label) return;
        try {
          const { currentUser, profileName, signOut, supabaseConfigured } = await import('../lib/auth');
          if (!supabaseConfigured) return;
          if (characters) characters.hidden = false;
          if (campaigns) campaigns.hidden = false;
          const user = await currentUser();
          if (!user) return;
          const name = await profileName();
          label.textContent = 'Sign out' + (name ? ' · ' + name : '');
          link.setAttribute('href', '#');
          link.addEventListener('click', async (e) => {
            e.preventDefault();
            await signOut();
            location.href = import.meta.env.BASE_URL;
          });
        } catch { /* not configured, offline, or blocked — leave the link alone */ }
      })();
    </script>
  </body>
</html>
